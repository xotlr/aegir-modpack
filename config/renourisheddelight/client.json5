{
	// Horizontal pixel offset for the food display UI (default: 0)
	"foodBarOffsetX": 0,
	// Vertical pixel offset for the food display UI (default: 0)
	"foodBarOffsetY": 0,
	// Item ID to sample for the golden-effect color palette (default: minecraft:golden_carrot)
	"goldenPaletteItem": "minecraft:golden_carrot",
	// Whether to render the active food items panel next to the inventory screen (default: false)
	"showFoodDisplayInInventory": false,
	// Whether to clip the last heart's unfillable half when the player has an odd max health, instead of showing a half heart that can never fill (default: true)
	"clipOddMaxHealthHeart": true,
	// Whether to compress the health bar into a single row of 10 hearts that fill proportionally to max health, instead of stacking extra heart rows (default: false)
	"compactHealthBar": true
}